# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/
.pytest_cache/

# Hawkeye runtime data — everything the system emits at run time lives
# under var/ (see hawkeye/paths.py). Human-written or human-approved
# material goes in strategy/ or docs/ and IS tracked.
var/
*.db
*.db-journal

# Env / secrets
.env.*
!.env.*.example
.claude/settings.local.json
